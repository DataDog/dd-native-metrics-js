{
  "name": "@datadog/native-metrics",
  "version": "2.0.0-pre",
  "description": "Native metrics collector for libuv and v8",
  "main": "index.js",
  "gypfile": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DataDog/dd-native-metrics-js.git"
  },
  "author": "Datadog Inc. <info@datadoghq.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/DataDog/dd-native-metrics-js#readme",
  "scripts": {
    "compile_commands": "node-gyp configure --release -- -f gyp.generator.compile_commands_json.py && mv Release/compile_commands.json ./",
    "rebuild": "node-gyp rebuild -j max",
    "lint": "node scripts/check_licenses.js && eslint .",
    "test": "mocha && node test/main"
  },
  "keywords": [
    "datadog",
    "metrics",
    "apm"
  ],
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "diff": "9.0.0",
    "glob": "13.0.6",
    "node-gyp": "$node-gyp",
    "serialize-javascript": "7.1.0",
    "tar": "7.5.22"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "chai": "^6.2.2",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.11.0",
    "mocha": "^11.8.0",
    "node-gyp": "13.0.1"
  }
}
